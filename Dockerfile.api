# RegimeCast API (FastAPI). Railway service "api", deployed from branch railway/api (docs/DEPLOY_RAILWAY.md).
FROM python:3.12-slim
WORKDIR /app
# LightGBM (stress classifier) needs the OpenMP runtime, which the slim image lacks
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY regimecast ./regimecast
# Small committed reports the API serves (e.g. data health). Market data is fetched live.
COPY data/reports ./data/reports
ENV REGIMECAST_DATA_DIR=/app/data PYTHONUNBUFFERED=1
EXPOSE 8000
# uvicorn logs to stderr; send it to stdout so Railway does not flag normal lines as errors.
CMD ["sh", "-c", "uvicorn regimecast.api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' 2>&1"]
