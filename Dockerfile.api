# RegimeCast API (FastAPI). Railway service "api"; config in deploy/api/railway.json.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY regimecast ./regimecast
# Small committed reports the API serves (e.g. data health). Market data is fetched live.
COPY data/reports ./data/reports
ENV REGIMECAST_DATA_DIR=/app/data PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["sh", "-c", "uvicorn regimecast.api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
