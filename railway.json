{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.recorder",
    "watchPatterns": [
      "regimecast/recorder/**",
      "regimecast/config.py",
      "regimecast/__init__.py",
      "Dockerfile.recorder",
      "requirements-recorder.txt",
      "railway.json"
    ]
  },
  "deploy": { "healthcheckPath": "/health", "restartPolicyType": "ALWAYS" }
}
