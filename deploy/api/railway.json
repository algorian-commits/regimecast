{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.api",
    "watchPatterns": [
      "regimecast/**",
      "requirements.txt",
      "Dockerfile.api",
      "data/reports/*.json",
      "deploy/api/railway.json"
    ]
  },
  "deploy": { "healthcheckPath": "/health", "restartPolicyType": "ON_FAILURE" }
}
